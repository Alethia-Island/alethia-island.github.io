@using Microsoft.AspNetCore.Components.Web

@if (string.IsNullOrWhiteSpace(Source))
{
    <div class="media-display media-display--empty" role="status">No media is available.</div>
}
else
{
    <figure class="media-display @CssClass">
        @switch (Kind)
        {
            case MediaKind.Image:
                <img src="@Source" alt="@AltText" loading="lazy" />
                break;
            case MediaKind.Video:
                <video src="@Source" controls preload="metadata" poster="@Poster" aria-label="@AltText">
                    Your browser does not support HTML video.
                </video>
                break;
            case MediaKind.Audio:
                <audio src="@Source" controls preload="metadata" aria-label="@AltText">
                    Your browser does not support HTML audio.
                </audio>
                break;
            case MediaKind.Document:
                <object data="@Source" type="@MimeType" aria-label="@AltText">
                    <a href="@Source" target="_blank" rel="noopener noreferrer">Open document</a>
                </object>
                break;
            case MediaKind.Embed:
                <iframe src="@Source" title="@AltText" loading="lazy" allowfullscreen="@AllowFullscreen"></iframe>
                break;
            default:
                <a class="media-display__download" href="@Source" target="_blank" rel="noopener noreferrer">
                    <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i> Open media
                </a>
                break;
        }

        @if (!string.IsNullOrWhiteSpace(Caption))
        {
            <figcaption>@Caption</figcaption>
        }
    </figure>
}

@code {
    [Parameter, EditorRequired] public string? Source { get; set; }
    [Parameter] public MediaKind Kind { get; set; } = MediaKind.Auto;
    [Parameter] public string AltText { get; set; } = "Media content";
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? Poster { get; set; }
    [Parameter] public string MimeType { get; set; } = "application/pdf";
    [Parameter] public bool AllowFullscreen { get; set; } = true;
    [Parameter] public string? CssClass { get; set; }

    protected override void OnParametersSet()
    {
        if (Kind == MediaKind.Auto && !string.IsNullOrWhiteSpace(Source))
            Kind = DetectKind(Source);
    }

    private static MediaKind DetectKind(string source)
    {
        var path = source.Split('?', '#')[0].ToLowerInvariant();
        return path.EndsWith(".jpg") || path.EndsWith(".jpeg") || path.EndsWith(".png") || path.EndsWith(".gif") || path.EndsWith(".webp") || path.EndsWith(".svg")
            ? MediaKind.Image
            : path.EndsWith(".mp4") || path.EndsWith(".webm") || path.EndsWith(".ogv") || path.EndsWith(".mov")
                ? MediaKind.Video
                : path.EndsWith(".mp3") || path.EndsWith(".wav") || path.EndsWith(".ogg") || path.EndsWith(".m4a") || path.EndsWith(".flac")
                    ? MediaKind.Audio
                    : path.EndsWith(".pdf")
                        ? MediaKind.Document
                        : MediaKind.Link;
    }

    public enum MediaKind { Auto, Image, Video, Audio, Document, Embed, Link }
}
