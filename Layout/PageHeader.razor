<PageTitle>@DocumentTitle</PageTitle>

@code {
    [Inject] private AppExtensions? AppExtensions { get; set; }

    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? SubTitle { get; set; }
    [Parameter] public string? Title { get; set; }

    private string DocumentTitle => string.IsNullOrWhiteSpace(Title)
        ? "Alethia Island"
        : $"Alethia Island - {Title}";

    protected override async Task OnParametersSetAsync()
    {
        if (AppExtensions is not null)
            await AppExtensions.SetPageTitle(Title, Icon);

        await base.OnParametersSetAsync();
    }
}
